R2D2_DB_PASSWORD=
# opcionais (defaults em los_checker.py):
# R2D2_DB_HOST=localhost
# R2D2_DB_PORT=5432
# R2D2_DB_NAME=ED
# R2D2_DB_USER=r2d2

# notificações de erro no Discord (infra_bridge.notificar_erro_discord) --
# webhook do canal, ver ~/tradingBot/.env se já tiveres um configurado
DISCORD_WEBHOOK_URL=
# identifica a máquina de origem nas mensagens -- default "vasco-r2d2-nobara"
# (este lado); o lado Windows deve definir "vasco-r2d2-win"
# VASCO_HOST_ID=vasco-r2d2-nobara
